{
	"name": "@habit-tracker/backend",
	"type": "module",
	"version": "1.0.50",
	"module": "src/index.js",
	"scripts": {
		"dev": "bun run --watch src/app.ts",
		"format": "bunx prettier --write .",
		"lint": "bunx eslint",
		"lint:fix": "bunx eslint --fix",
		"check-types": "bunx tsc --noEmit",
		"pretty": "bun run format && bun run lint:fix",
		"check": "bun run check-types && bun run pretty",
		"db:push": "bunx drizzle-kit push",
		"db:pull": "bunx drizzle-kit pull",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bunx drizzle-kit migrate",
		"db:studio": "bunx drizzle-kit studio"
	},
	"dependencies": {
		"drizzle-orm": "^0.44.6",
		"elysia": "latest",
		"env-var": "^7.5.0",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@0x32/eslint": "^1.0.2",
		"@0x32/prettier": "^1.0.2",
		"@types/pg": "^8.15.5",
		"bun-types": "latest",
		"drizzle-kit": "^0.31.5",
		"eslint": "^9.38.0",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3"
	}
}
